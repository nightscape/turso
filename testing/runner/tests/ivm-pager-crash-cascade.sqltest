@database :memory:
@skip-file-if mvcc "materialized views not supported in MVCC mode"
@requires materialized_views "requires materialized view support"

test ivm-pager-crash-3level-cascade {
    -- Schema: navigation cursor -> history -> block tree
    CREATE TABLE block (
        id TEXT PRIMARY KEY,
        parent_id TEXT,
        document_id TEXT,
        content TEXT NOT NULL DEFAULT '',
        content_type TEXT NOT NULL DEFAULT 'text',
        properties TEXT
    );
    CREATE INDEX idx_block_parent_id ON block(parent_id);

    CREATE TABLE navigation_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        region TEXT NOT NULL,
        block_id TEXT
    );
    CREATE INDEX idx_navigation_history_region ON navigation_history(region);

    CREATE TABLE navigation_cursor (
        region TEXT PRIMARY KEY,
        history_id INTEGER REFERENCES navigation_history(id)
    );

    -- MV-A: simple JOIN (level 1)
    CREATE MATERIALIZED VIEW current_focus AS
    SELECT nc.region, nh.block_id, nh.id AS history_id
    FROM navigation_cursor nc
    JOIN navigation_history nh ON nc.history_id = nh.id;

    -- MV-B: JOIN + UNION ALL (level 2)
    CREATE MATERIALIZED VIEW focus_roots AS
    SELECT cf.region, cf.block_id, b.id AS root_id
    FROM current_focus AS cf
    JOIN block AS b ON b.parent_id = cf.block_id
    UNION ALL
    SELECT cf.region, cf.block_id, b.id AS root_id
    FROM current_focus AS cf
    JOIN block AS b ON b.id = cf.block_id;

    -- Seed navigation
    INSERT INTO navigation_cursor (region, history_id) VALUES ('main', NULL);

    -- Insert a document root and build a tree with ~100 blocks
    -- Root block (doc root)
    INSERT INTO block VALUES ('block:doc-root', 'doc:mydoc', 'doc:mydoc', 'Doc Root', 'text', NULL);

    -- Level 1 children (10 blocks under doc-root)
    INSERT INTO block VALUES ('block:L1-0', 'block:doc-root', 'doc:mydoc', 'L1-0', 'text', '{"sequence":0}');
    INSERT INTO block VALUES ('block:L1-1', 'block:doc-root', 'doc:mydoc', 'L1-1', 'text', '{"sequence":1}');
    INSERT INTO block VALUES ('block:L1-2', 'block:doc-root', 'doc:mydoc', 'L1-2', 'text', '{"sequence":2}');
    INSERT INTO block VALUES ('block:L1-3', 'block:doc-root', 'doc:mydoc', 'L1-3', 'text', '{"sequence":3}');
    INSERT INTO block VALUES ('block:L1-4', 'block:doc-root', 'doc:mydoc', 'L1-4', 'text', '{"sequence":4}');
    INSERT INTO block VALUES ('block:L1-5', 'block:doc-root', 'doc:mydoc', 'L1-5', 'text', '{"sequence":5}');
    INSERT INTO block VALUES ('block:L1-6', 'block:doc-root', 'doc:mydoc', 'L1-6', 'text', '{"sequence":6}');
    INSERT INTO block VALUES ('block:L1-7', 'block:doc-root', 'doc:mydoc', 'L1-7', 'text', '{"sequence":7}');
    INSERT INTO block VALUES ('block:L1-8', 'block:doc-root', 'doc:mydoc', 'L1-8', 'text', '{"sequence":8}');
    INSERT INTO block VALUES ('block:L1-9', 'block:doc-root', 'doc:mydoc', 'L1-9', 'text', '{"sequence":9}');

    -- Level 2 children (10 blocks each under L1-0..L1-9 = 100 blocks)
    INSERT INTO block VALUES ('block:L2-0-0', 'block:L1-0', 'doc:mydoc', 'L2-0-0', 'text', '{"sequence":0}');
    INSERT INTO block VALUES ('block:L2-0-1', 'block:L1-0', 'doc:mydoc', 'L2-0-1', 'text', '{"sequence":1}');
    INSERT INTO block VALUES ('block:L2-0-2', 'block:L1-0', 'doc:mydoc', 'L2-0-2', 'text', '{"sequence":2}');
