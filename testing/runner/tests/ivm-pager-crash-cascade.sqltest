    INSERT INTO block VALUES ('block:L2-6-6', 'block:L1-6', 'doc:mydoc', 'L2-6-6', 'text', '{"sequence":6}');
    INSERT INTO block VALUES ('block:L2-6-7', 'block:L1-6', 'doc:mydoc', 'L2-6-7', 'text', '{"sequence":7}');
    INSERT INTO block VALUES ('block:L2-6-8', 'block:L1-6', 'doc:mydoc', 'L2-6-8', 'text', '{"sequence":8}');
    INSERT INTO block VALUES ('block:L2-6-9', 'block:L1-6', 'doc:mydoc', 'L2-6-9', 'text', '{"sequence":9}');
