    INSERT INTO block VALUES ('block:L2-9-2', 'block:L1-9', 'doc:mydoc', 'L2-9-2', 'text', '{"sequence":2}');
    INSERT INTO block VALUES ('block:L2-9-3', 'block:L1-9', 'doc:mydoc', 'L2-9-3', 'text', '{"sequence":3}');
    INSERT INTO block VALUES ('block:L2-9-4', 'block:L1-9', 'doc:mydoc', 'L2-9-4', 'text', '{"sequence":4}');
    INSERT INTO block VALUES ('block:L2-9-5', 'block:L1-9', 'doc:mydoc', 'L2-9-5', 'text', '{"sequence":5}');
    INSERT INTO block VALUES ('block:L2-9-6', 'block:L1-9', 'doc:mydoc', 'L2-9-6', 'text', '{"sequence":6}');
    INSERT INTO block VALUES ('block:L2-9-7', 'block:L1-9', 'doc:mydoc', 'L2-9-7', 'text', '{"sequence":7}');
    INSERT INTO block VALUES ('block:L2-9-8', 'block:L1-9', 'doc:mydoc', 'L2-9-8', 'text', '{"sequence":8}');
    INSERT INTO block VALUES ('block:L2-9-9', 'block:L1-9', 'doc:mydoc', 'L2-9-9', 'text', '{"sequence":9}');

    -- MV-C: recursive CTE walking the block tree (level 3) - reads from focus_roots
    CREATE MATERIALIZED VIEW watch_view AS
    WITH RECURSIVE tree AS (
        SELECT b.id AS node_id, b.id AS source_id, 0 AS depth,
               CAST(b.id AS TEXT) AS visited
        FROM block AS b
        UNION ALL
        SELECT child.id, tree.source_id, tree.depth + 1,
               tree.visited || ',' || CAST(child.id AS TEXT)
        FROM tree
        JOIN block child ON child.parent_id = tree.node_id
        WHERE tree.depth < 20
          AND ',' || tree.visited || ',' NOT LIKE '%,' || CAST(child.id AS TEXT) || ',%'
    )
    SELECT b.*, json_extract(b.properties, '$.sequence') AS sequence
    FROM focus_roots AS fr
    JOIN block AS root ON root.id = fr.root_id
    JOIN tree ON tree.source_id = root.id
    JOIN block AS b ON b.id = tree.node_id
    WHERE fr.region = 'main'
      AND b.content_type <> 'source'
      AND tree.depth >= 0 AND tree.depth <= 20;

    -- Navigation cycle 1: point cursor at doc-root
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:doc-root');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 1);

    -- Navigation cycle 2: different target
    DELETE FROM navigation_history WHERE region = 'main' AND id > 1;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:L1-0');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 2);

    -- Navigation cycle 3
    DELETE FROM navigation_history WHERE region = 'main' AND id > 2;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:doc-root');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 3);

    -- Navigation cycle 4
    DELETE FROM navigation_history WHERE region = 'main' AND id > 3;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:L1-1');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 4);

    -- Navigation cycle 5 (crash typically occurs here)
    DELETE FROM navigation_history WHERE region = 'main' AND id > 4;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:doc-root');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 5);

    -- Navigation cycles 6-10 (additional stress)
    DELETE FROM navigation_history WHERE region = 'main' AND id > 5;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:L1-2');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 6);

    DELETE FROM navigation_history WHERE region = 'main' AND id > 6;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:doc-root');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 7);

    DELETE FROM navigation_history WHERE region = 'main' AND id > 7;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:L1-3');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 8);

    DELETE FROM navigation_history WHERE region = 'main' AND id > 8;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:doc-root');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 9);

    DELETE FROM navigation_history WHERE region = 'main' AND id > 9;
    INSERT INTO navigation_history (region, block_id) VALUES ('main', 'block:L1-4');
    INSERT OR REPLACE INTO navigation_cursor (region, history_id) VALUES ('main', 10);

    -- If we get here without crashing, verify the matview is queryable
    SELECT COUNT(*) > 0 FROM watch_view;
}
expect {
    1
}
