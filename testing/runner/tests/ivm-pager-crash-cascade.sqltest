    INSERT INTO block VALUES ('block:L2-6-3', 'block:L1-6', 'doc:mydoc', 'L2-6-3', 'text', '{"sequence":3}');
    INSERT INTO block VALUES ('block:L2-6-4', 'block:L1-6', 'doc:mydoc', 'L2-6-4', 'text', '{"sequence":4}');
