@database :memory:
@skip-file-if mvcc "materialized views not supported in MVCC mode"
@requires materialized_views "requires materialized view support"

# Basic rollback: INSERT should be undone in the matview
test matview-rollback-insert {
    CREATE TABLE t(a INTEGER, b INTEGER);
    INSERT INTO t VALUES (1, 10), (2, 20), (3, 30);
    CREATE MATERIALIZED VIEW v AS SELECT * FROM t WHERE b > 15;
    SELECT * FROM v ORDER BY a;
    BEGIN;
    INSERT INTO t VALUES (4, 40), (5, 50);
    SELECT * FROM v ORDER BY a;
    ROLLBACK;
    SELECT * FROM v ORDER BY a;
}
expect {
    2|20
    3|30
    2|20
    3|30
    4|40
    5|50
    2|20
    3|30
}

# Rollback DELETE: deleted rows should reappear in the matview
test matview-rollback-delete {
    CREATE TABLE t2(a INTEGER, b INTEGER);
    INSERT INTO t2 VALUES (1, 10), (2, 20), (3, 30), (4, 40);
    CREATE MATERIALIZED VIEW v2 AS SELECT * FROM t2 WHERE b > 15;
    SELECT * FROM v2 ORDER BY a;
    BEGIN;
    DELETE FROM t2 WHERE a IN (2, 3);
    SELECT * FROM v2 ORDER BY a;
    ROLLBACK;
    SELECT * FROM v2 ORDER BY a;
}
expect {
    2|20
    3|30
    4|40
    4|40
    2|20
    3|30
    4|40
}

# Rollback UPDATE: updated rows should revert in the matview
test matview-rollback-update {
    CREATE TABLE t3(a INTEGER, b INTEGER);
    INSERT INTO t3 VALUES (1, 10), (2, 20), (3, 30);
    CREATE MATERIALIZED VIEW v3 AS SELECT * FROM t3 WHERE b > 15;
    SELECT * FROM v3 ORDER BY a;
    BEGIN;
    UPDATE t3 SET b = 5 WHERE a = 2;
    UPDATE t3 SET b = 35 WHERE a = 1;
    SELECT * FROM v3 ORDER BY a;
    ROLLBACK;
    SELECT * FROM v3 ORDER BY a;
}
expect {
    2|20
    3|30
    1|35
    3|30
    2|20
    3|30
}

# Rollback with aggregation: SUM/COUNT should revert
test matview-rollback-aggregation {
    CREATE TABLE sales(product_id INTEGER, amount INTEGER);
    INSERT INTO sales VALUES (1, 100), (1, 200), (2, 150), (2, 250);
    CREATE MATERIALIZED VIEW product_totals AS
    SELECT product_id, SUM(amount) as total, COUNT(*) as cnt
    FROM sales GROUP BY product_id;
    SELECT * FROM product_totals ORDER BY product_id;
    BEGIN;
    INSERT INTO sales VALUES (1, 50), (3, 300);
    SELECT * FROM product_totals ORDER BY product_id;
    ROLLBACK;
    SELECT * FROM product_totals ORDER BY product_id;
}
expect {
    1|300.0|2
    2|400.0|2
    1|350.0|3
    2|400.0|2
    3|300.0|1
    1|300.0|2
    2|400.0|2
}

# Recursive CTE matview rollback: the key bug from the handoff
test matview-rollback-recursive-cte {
    CREATE TABLE nodes(id INTEGER PRIMARY KEY, parent_id INTEGER);
    INSERT INTO nodes VALUES (1, NULL), (2, 1), (3, 1), (4, 2);
    CREATE MATERIALIZED VIEW tree AS
      WITH RECURSIVE walk AS (
        SELECT id, parent_id FROM nodes WHERE parent_id IS NULL
        UNION ALL
        SELECT n.id, n.parent_id FROM nodes n JOIN walk w ON n.parent_id = w.id
      ) SELECT * FROM walk;
    SELECT COUNT(*) FROM tree;
    BEGIN;
    INSERT INTO nodes VALUES (5, 3), (6, 4);
    SELECT COUNT(*) FROM tree;
    ROLLBACK;
    SELECT COUNT(*) FROM tree;
}
expect {
    4
    6
    4
}

# Recursive CTE matview: rollback then new commit should work correctly
test matview-rollback-then-commit-recursive {
    CREATE TABLE items(id INTEGER PRIMARY KEY, parent_id INTEGER, label TEXT);
    INSERT INTO items VALUES (1, NULL, 'root');
    CREATE MATERIALIZED VIEW item_tree AS
      WITH RECURSIVE t AS (
        SELECT id, parent_id, label FROM items WHERE parent_id IS NULL
        UNION ALL
        SELECT i.id, i.parent_id, i.label FROM items i JOIN t ON i.parent_id = t.id
      ) SELECT * FROM t;
    SELECT COUNT(*) FROM item_tree;
    BEGIN;
    INSERT INTO items VALUES (2, 1, 'child1'), (3, 1, 'child2');
    SELECT COUNT(*) FROM item_tree;
    ROLLBACK;
    SELECT COUNT(*) FROM item_tree;
    INSERT INTO items VALUES (10, 1, 'real_child');
    SELECT COUNT(*) FROM item_tree;
}
expect {
    1
    3
    1
    2
}

# Rollback then commit on non-recursive matview
test matview-rollback-then-commit {
    CREATE TABLE data(x INTEGER, y INTEGER);
    INSERT INTO data VALUES (1, 100);
    CREATE MATERIALIZED VIEW vd AS SELECT * FROM data;
    SELECT * FROM vd;
    BEGIN;
    INSERT INTO data VALUES (2, 200);
    SELECT * FROM vd ORDER BY x;
    ROLLBACK;
    SELECT * FROM vd;
    INSERT INTO data VALUES (3, 300);
    SELECT * FROM vd ORDER BY x;
}
expect {
    1|100
    1|100
    2|200
    1|100
    1|100
    3|300
}

# Multiple rollbacks should not corrupt state
test matview-multiple-rollbacks {
    CREATE TABLE multi(id INTEGER PRIMARY KEY, val INTEGER);
    INSERT INTO multi VALUES (1, 10);
    CREATE MATERIALIZED VIEW vm AS SELECT * FROM multi;
    SELECT * FROM vm;
    BEGIN;
    INSERT INTO multi VALUES (2, 20);
    ROLLBACK;
    SELECT * FROM vm;
    BEGIN;
    INSERT INTO multi VALUES (3, 30);
    ROLLBACK;
    SELECT * FROM vm;
    INSERT INTO multi VALUES (4, 40);
    SELECT * FROM vm ORDER BY id;
}
expect {
    1|10
    1|10
    1|10
    1|10
    4|40
}

# Recursive CTE UNION ALL rollback (the variant most sensitive to operator state)
test matview-rollback-recursive-union-all {
    CREATE TABLE edges(src INTEGER, dst INTEGER);
    INSERT INTO edges VALUES (1, 2), (2, 3), (3, 4);
    CREATE MATERIALIZED VIEW paths AS
      WITH RECURSIVE p AS (
        SELECT src, dst FROM edges WHERE src = 1
        UNION ALL
        SELECT p.src, e.dst FROM edges e JOIN p ON e.src = p.dst
      ) SELECT * FROM p;
    SELECT COUNT(*) FROM paths;
    BEGIN;
    INSERT INTO edges VALUES (4, 5), (5, 6);
    SELECT COUNT(*) FROM paths;
    ROLLBACK;
    SELECT COUNT(*) FROM paths;
}
expect {
    3
    5
    3
}
