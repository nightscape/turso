    INSERT INTO block VALUES ('block:L2-7-1', 'block:L1-7', 'doc:mydoc', 'L2-7-1', 'text', '{"sequence":1}');
    INSERT INTO block VALUES ('block:L2-7-2', 'block:L1-7', 'doc:mydoc', 'L2-7-2', 'text', '{"sequence":2}');
    INSERT INTO block VALUES ('block:L2-7-3', 'block:L1-7', 'doc:mydoc', 'L2-7-3', 'text', '{"sequence":3}');
    INSERT INTO block VALUES ('block:L2-7-4', 'block:L1-7', 'doc:mydoc', 'L2-7-4', 'text', '{"sequence":4}');
    INSERT INTO block VALUES ('block:L2-7-5', 'block:L1-7', 'doc:mydoc', 'L2-7-5', 'text', '{"sequence":5}');
