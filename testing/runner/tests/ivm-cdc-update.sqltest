@database :memory:
@skip-file-if mvcc "materialized views not supported in MVCC mode"
@requires materialized_views "requires materialized view support"

# IVM matview UPDATE propagation

test matview-update-single-row {
    CREATE TABLE t1 (id TEXT PRIMARY KEY, val TEXT);
    INSERT INTO t1 VALUES ('a', 'old');
    CREATE MATERIALIZED VIEW mv1 AS SELECT id, val FROM t1;
    UPDATE t1 SET val = 'new' WHERE id = 'a';
    SELECT val FROM mv1 WHERE id = 'a';
}
expect {
    new
}

test matview-update-multi-row {
    CREATE TABLE t2 (id TEXT PRIMARY KEY, val TEXT);
    INSERT INTO t2 VALUES ('a', 'old_a');
    INSERT INTO t2 VALUES ('b', 'old_b');
    INSERT INTO t2 VALUES ('c', 'old_c');
    CREATE MATERIALIZED VIEW mv2 AS SELECT id, val FROM t2;
    UPDATE t2 SET val = 'new_b' WHERE id = 'b';
    SELECT val FROM mv2 WHERE id = 'b';
}
expect {
    new_b
}

test matview-update-5-rows {
    CREATE TABLE t3 (id TEXT PRIMARY KEY, content TEXT NOT NULL DEFAULT '');
    INSERT INTO t3 (id, content) VALUES ('b0', 'content 0');
    INSERT INTO t3 (id, content) VALUES ('b1', 'content 1');
    INSERT INTO t3 (id, content) VALUES ('b2', 'content 2');
    INSERT INTO t3 (id, content) VALUES ('b3', 'content 3');
    INSERT INTO t3 (id, content) VALUES ('b4', 'content 4');
    CREATE MATERIALIZED VIEW mv3 AS SELECT id, content FROM t3;
    UPDATE t3 SET content = 'CHANGED' WHERE id = 'b2';
    SELECT content FROM mv3 WHERE id = 'b2';
}
expect {
    CHANGED
}

test matview-select-star-update {
    CREATE TABLE t4 (id TEXT PRIMARY KEY, val TEXT);
    INSERT INTO t4 VALUES ('a', 'old_a');
    INSERT INTO t4 VALUES ('b', 'old_b');
    CREATE MATERIALIZED VIEW mv4 AS SELECT * FROM t4;
    UPDATE t4 SET val = 'new_b' WHERE id = 'b';
    SELECT val FROM mv4 WHERE id = 'b';
}
expect {
    new_b
}

test matview-delete-multi-row {
    CREATE TABLE t5 (id TEXT PRIMARY KEY, val TEXT);
    INSERT INTO t5 VALUES ('a', 'val_a');
    INSERT INTO t5 VALUES ('b', 'val_b');
    INSERT INTO t5 VALUES ('c', 'val_c');
    CREATE MATERIALIZED VIEW mv5 AS SELECT id, val FROM t5;
    DELETE FROM t5 WHERE id = 'b';
    SELECT COUNT(*) FROM mv5;
}
expect {
    2
}
