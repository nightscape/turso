    INSERT INTO block VALUES ('block:L2-5-8', 'block:L1-5', 'doc:mydoc', 'L2-5-8', 'text', '{"sequence":8}');
    INSERT INTO block VALUES ('block:L2-5-9', 'block:L1-5', 'doc:mydoc', 'L2-5-9', 'text', '{"sequence":9}');
    INSERT INTO block VALUES ('block:L2-6-0', 'block:L1-6', 'doc:mydoc', 'L2-6-0', 'text', '{"sequence":0}');
